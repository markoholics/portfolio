    {
      "id": "bd_check_profile_progress",
      "name": "Bright Data: Check Profile Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1420, 480 ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.brightdata.com/datasets/v3/progress/{{$('Bright Data: Trigger LinkedIn Profile Scrape').item.json.snapshot_id}}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "brightdata_api_token_cred",
          "name": "Bright Data API Token (Bearer)"
        }
      }
    },
    {
      "id": "bd_eval_profile_poll",
      "name": "Evaluate Profile Poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1660, 480 ],
      "parameters": {
        "jsCode": "const status = $json.status;\nconst attempts = $('Bright Data: Check Profile Progress').all().length;\nconst maxAttempts = Number($env.BRIGHTDATA_MAX_POLL_ATTEMPTS || 20);\nconst shouldStop = status === 'ready' || status === 'failed' || attempts >= maxAttempts;\n\nreturn [{\n  json: {\n    shouldStop,\n    status,\n    attempts,\n    snapshot_id: $('Bright Data: Trigger LinkedIn Profile Scrape').item.json.snapshot_id\n  }\n}];"
      }
    },
    {
      "id": "bd_if_profile_ready",
      "name": "IF: Profile Poll Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 1900, 480 ],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.shouldStop}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "bd_fetch_profile_result",
      "name": "Bright Data: Fetch Profile Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 2140, 380 ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.brightdata.com/datasets/v3/snapshot/{{$json.snapshot_id}}?format=json",
