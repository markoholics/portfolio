        "amount": 8,
        "unit": "seconds"
      }
    },
    {
      "id": "bd_check_company_progress",
      "name": "Bright Data: Check Company Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 2860, 380 ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.brightdata.com/datasets/v3/progress/{{$('Bright Data: Trigger LinkedIn Company Scrape').item.json.snapshot_id}}",
        "options": {
