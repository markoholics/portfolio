    },
    {
      "id": "bd_trigger_company",
      "name": "Bright Data: Trigger LinkedIn Company Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 2380, 380 ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.brightdata.com/datasets/v3/trigger?dataset_id={{$env.BRIGHTDATA_LINKEDIN_COMPANY_DATASET_ID}}&include_errors=true",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ [ { \"url\": (Array.isArray($json) ? $json[0] : $json).company_url || (Array.isArray($json) ? $json[0] : $json).current_company_url || $('Loop Over Leads').item.json.Company_LinkedIn_URL } ] }}",
        "options": {
          "timeout": 30000
        }
      },
