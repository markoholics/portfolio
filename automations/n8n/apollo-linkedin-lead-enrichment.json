    {
      "id": "bd_eval_company_poll",
      "name": "Evaluate Company Poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 3100, 380 ],
      "parameters": {
        "jsCode": "const status = $json.status;\nconst attempts = $('Bright Data: Check Company Progress').all().length;\nconst maxAttempts = Number($env.BRIGHTDATA_MAX_POLL_ATTEMPTS || 20);\nconst shouldStop = status === 'ready' || status === 'failed' || attempts >= maxAttempts;\n\nreturn [{\n  json: {\n    shouldStop,\n    status,\n    attempts,\n    snapshot_id: $('Bright Data: Trigger LinkedIn Company Scrape').item.json.snapshot_id\n  }\n}];"
      }
    },
    {
      "id": "bd_if_company_ready",
      "name": "IF: Company Poll Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 3340, 380 ],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.shouldStop}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
