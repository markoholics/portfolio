SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# /gtm-audit Razorpay Standard Checkout. NEXT_PUBLIC_RAZORPAY_KEY_ID is safe
# to expose to the browser (Razorpay Checkout requires it client-side);
# RAZORPAY_KEY_SECRET must only ever be set server-side (this file, or the
# hosting provider's env var settings) and never committed or shipped to
# the client.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Webhook for src/app/api/gtm-audit/razorpay-webhook: set this to the secret
# you choose when creating the webhook in the Razorpay Dashboard (Settings >
# Webhooks), not the API key secret above — they're two different values.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email notifications (src/lib/email.ts) for the contact form and both
# /gtm-audit and /free-gtm-audit lead-capture forms, sent via Resend's HTTP
# API (https://resend.com — no SDK needed). Each submission sends two
# emails: an internal notification to NOTIFY_EMAIL, and a confirmation
# straight to the address the visitor typed in (validated against
# abc@xyz.com format before either send). Get RESEND_API_KEY from your
# Resend dashboard. RESEND_FROM_EMAIL defaults to Resend's shared testing
# sender (onboarding@resend.dev), which can only deliver to your own
# Resend account address — verify a domain in Resend and set
# RESEND_FROM_EMAIL to an address on it to reliably email visitors.
# NOTIFY_EMAIL defaults to contact@markoholics.com.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=contact@markoholics.com

# /fit-check. See src/lib/fit-check/README.md for the full picture —
# questions, weights, thresholds and prices all live in
# src/lib/fit-check/config.ts, not here. SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# and RESEND_* above are reused for Fit Check's own table and emails.
#
# Slack incoming webhook (https://api.slack.com/messaging/webhooks) for the
# Green-path internal alert.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Make scenario webhook: receives every submission's full payload plus the
# computed route, for routing on to Notion, Brevo, Apollo enrichment, etc.
MAKE_FIT_CHECK_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id
# Shared secret for GET /api/fit-check/export (the internal analytics/CSV
# view — there is no login system on this site). Generate with, e.g.,
# `openssl rand -hex 32` and keep it private.
FIT_CHECK_EXPORT_KEY=a-long-random-string

# /roundtable interest form (src/app/api/interest/route.ts). See
# src/app/roundtable/README.md for the full setup guide. All copy, metrics
# and form options live in src/content/roundtable.ts, not here.
#
# Uses the RESEND_API_KEY above (its own npm package, not the raw-fetch
# helper the rest of the site uses). FROM_EMAIL is the sender on the
# thank you email; CONTACT_EMAIL is where the internal notification goes
# and the address shown throughout the page. Set NOTIFY_EXTRA_EMAILS to a
# comma separated list to copy the internal notification to more inboxes.
FROM_EMAIL=Markoholics <contact@markoholics.com>
CONTACT_EMAIL=contact@markoholics.com
NOTIFY_EXTRA_EMAILS=

# Set to false to allow free providers (gmail.com, yahoo.com, etc.) through
# the business email check. Defaults to true (enforced) when unset.
ENFORCE_BUSINESS_EMAIL=true

# Optional: POSTs every valid submission to a Google Apps Script webhook as
# a backup alongside email. See src/app/roundtable/README.md for the Apps
# Script snippet this expects. Leave unset to skip the backup entirely.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: cross-instance rate limiting for POST /api/interest via Upstash
# Redis (https://upstash.com, the free tier is enough for this). Leave
# both unset to fall back to a simple in-memory limiter, fine for local dev
# or a low-traffic launch, but it resets on every serverless cold start and
# does not coordinate across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, no cookies, no third-party trackers: loads the Plausible
# Analytics script site-wide when set to your Plausible site domain (e.g.
# markoholics.com). Leave unset to not load it at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
